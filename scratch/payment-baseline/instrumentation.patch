+/// Restores the tag it replaced; an enclosing tag of the same kind wins.
+pub(crate) struct Scope {
+    phase: bool,
+    owner: bool,
+    name: &'static str,
+    plans: u64,
+    models: u64,
+}
+
+pub(crate) fn phase(name: &'static str) -> Scope {
+    LOCAL.with(|l| {
+        let local = &mut *l.borrow_mut();
+        let owner = local.phase.is_none();
+        if owner {
+            local.phase = Some(name);
+        }
+        Scope {
+            phase: true,
+            owner,
+            name,
+            plans: local.metrics.plans,
+            models: local.metrics.models,
+        }
+    })
+}
+
+pub(crate) fn site(name: &'static str) -> Scope {
+    LOCAL.with(|l| {
+        let local = &mut *l.borrow_mut();
+        let owner = local.site.is_none();
+        if owner {
+            local.site = Some(name);
+        }
+        Scope {
+            phase: false,
+            owner,
+            name,
+            plans: 0,
+            models: 0,
+        }
+    })
+}
+
+impl Drop for Scope {
+    fn drop(&mut self) {
+        if !self.owner {
+            return;
+        }
+        LOCAL.with(|l| {
+            let local = &mut *l.borrow_mut();
+            if self.phase {
+                local.phase = None;
+                let plans = local.metrics.plans - self.plans;
+                let models = local.metrics.models - self.models;
+                bump(
+                    local
+                        .metrics
+                        .plans_per_computation
+                        .entry(self.name.into())
+                        .or_default(),
+                    plans,
+                );
+                bump(
+                    local
+                        .metrics
+                        .models_per_computation
+                        .entry(self.name.into())
+                        .or_default(),
+                    models,
+                );
+            } else {
+                local.site = None;
+            }
+        });
+    }
+}
+
+fn key(local: &Local, class: Option<&'static str>) -> String {
+    let mut key = format!(
+        "{}/{}",
+        local.phase.unwrap_or("execution"),
+        local.site.unwrap_or("untagged")
+    );
+    if let Some(class) = class {
+        key.push('/');
+        key.push_str(class);
+    }
+    key
+}
