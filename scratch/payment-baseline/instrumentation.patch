+    pub with_abilities: bool,
+}
+
+pub(crate) fn model(elapsed: Duration, facts: ModelFacts) {
+    LOCAL.with(|l| {
+        let local = &mut *l.borrow_mut();
+        let ns = elapsed.as_nanos() as u64;
+        local.metrics.models += 1;
+        local.metrics.model_ns += ns;
+        local.step_models += 1;
+        bump(&mut local.metrics.sources_per_model, facts.sources as u64);
+        let same_model = local
+            .step_models_seen
+            .insert(facts.reserved ^ facts.player as u64, ())
+            .is_some();
+        let revision_key = (facts.player, facts.revisions.0, facts.revisions.1);
+        let in_step = local.step_revisions.get(&revision_key).copied();
+        local.step_revisions.insert(revision_key, facts.unreserved);
+        let previous = local.previous[facts.player]
+            .filter(|(revisions, _)| *revisions == facts.revisions)
+            .map(|(_, unreserved)| unreserved);
+        local.previous[facts.player] = Some((facts.revisions, facts.unreserved));
+        let row_key = key(local, None);
+        let row = local.metrics.model_rows.entry(row_key).or_default();
+        row.builds += 1;
+        row.ns += ns;
+        row.sources += facts.sources as u64;
+        row.with_abilities += u64::from(facts.with_abilities);
+        row.same_model_in_step += u64::from(same_model);
+        row.same_revision_in_step += u64::from(in_step.is_some());
+        row.same_revision_as_previous += u64::from(previous.is_some());
+        row.revision_match_differs += u64::from(
+            in_step
+                .or(previous)
+                .is_some_and(|seen| seen != facts.unreserved),
+        );
+    });
 }
 
