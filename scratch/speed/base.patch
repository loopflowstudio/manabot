-def damped_policy_loss(
-    logits: Tensor,
-    actions: Tensor,
-    advantages: Tensor,
-    behavior_logs: Tensor,
-    reference: Tensor,
-    valid: Tensor,
-    *,
-    clip: float,
-    collection_kl: float,
-    tau: float,
-) -> Tensor:
-    """The damped policy objective, equation (6), per row [B] over offers [B,A].
