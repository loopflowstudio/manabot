-    logs = logits.masked_fill(~valid, -torch.inf).log_softmax(-1)
-    require(
-        torch.isfinite(logs) | ~valid,
-        "nonfinite_legal_logs",
-        logs=logs,
-        logits=logits,
-        valid=valid,
