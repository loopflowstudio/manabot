+def resolve(name: str) -> ModuleType:
+    """Load a backend lazily, with a useful error for an absent optional extra."""
+    if name not in {"torch", "mlx"}:
+        raise ValueError(f"unknown backend {name!r}; available backends: torch, mlx")
