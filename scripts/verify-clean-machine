cleanup() {
  terminate_tree() {
    for child in $(pgrep -P "$1" 2>/dev/null); do
      terminate_tree "$child"
    done
    kill -TERM "$1" 2>/dev/null || true
  }
  if [ -n "$proof_pid" ]; then
    if kill -0 "$proof_pid" 2>/dev/null; then
      terminate_tree "$proof_pid"
    fi
    wait "$proof_pid" 2>/dev/null || true
  fi
  if kill -0 "$launcher_pid" 2>/dev/null; then
    terminate_tree "$launcher_pid"
  fi
  wait "$launcher_pid" 2>/dev/null || true
  if [ -n "$readiness_timer_pid" ]; then
    kill -TERM "$readiness_timer_pid" 2>/dev/null || true
    wait "$readiness_timer_pid" 2>/dev/null || true
  fi
}
trap cleanup 0 HUP INT TERM

while ! grep -q '^ACADEMY_PLAY_READY ' "$log" 2>/dev/null; do
  if ! kill -0 "$launcher_pid" 2>/dev/null; then
    cat "$log" >&2
    proof_error proof.launch "./scripts/play exited before readiness"
  fi
  if ! kill -0 "$readiness_timer_pid" 2>/dev/null; then
    cat "$log" >&2
