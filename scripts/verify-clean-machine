#!/bin/sh

set -u

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT" || exit 1

proof_error() {
  code=$1
  message=$2
  printf 'ACADEMY_CLEAN_PROOF_ERROR {"schema_version":1,"code":"%s","message":"%s"}\n' \
    "$code" "$message" >&2
  exit 2
}

[ ! -e .venv ] || proof_error proof.dirty ".venv exists before the clean proof"
