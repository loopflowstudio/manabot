#!/bin/sh

set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"

uv run --extra play maturin develop --release --manifest-path managym/Cargo.toml --features python

cargo test --manifest-path managym/Cargo.toml authored_match_parity --no-fail-fast
uv run --extra dev python -m academy.authored_match_parity verify
